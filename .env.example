# ==============================================================================
# 韩语学习平台 (Korean Master) - 环境变量模板
# 使用说明：
# 1. 本地开发请复制本文件为 .env：cp .env.example .env
# 2. 严禁将包含真实密钥的 .env 文件提交到 Git 仓库！
# ==============================================================================

# 应用运行环境 (development | test | production)
NODE_ENV=development

# 服务监听端口
PORT=3000

# 应用公开访问地址
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 本地 SQLite 数据库存储路径（待定扩展：后续如需切换 PostgreSQL 可直接修改连接串）
DATABASE_URL="file:./data/korean.db"

# 语音合成配置（默认使用浏览器原生 Web Speech API + 免费韩语 TTS 兜底，无需 API Key）
TTS_DEFAULT_VOICE="ko-KR-SunHiNeural"
TTS_SPEECH_RATE="1.0"

# 预留第三方 AI 助教密钥占位符（可选，切勿填入真实生产密钥提交到仓库）
AI_API_KEY="<YOUR_AI_API_KEY_PLACEHOLDER>"
AI_BASE_URL="https://api.example.com/v1"

# 中译韩免密钥公开端点（服务端 /api/translate 使用，均无需 API Key）
# 留空时使用代码内置默认值；若部署环境访问受限，可在此改成可访问的镜像端点
TRANSLATE_GOOGLE_URL="https://translate.googleapis.com/translate_a/single"
TRANSLATE_MYMEMORY_URL="https://api.mymemory.translated.net/get"
